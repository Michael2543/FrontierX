{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-x86_64-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FRONTIERX_BUILD_SDL3": "ON",
        "FRONTIERX_BUILD_SDL3_GPU": "ON"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux x86_64 GCC Debug",
      "inherits": "linux-x86_64-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux x86_64 Clang Debug",
      "inherits": "linux-x86_64-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "targets": [
        "frontierx_layout_probe",
        "frontierx_tinyxml_probe",
        "frontierx_string_table_file_text_probe",
        "frontierx_platform_time_probe",
        "frontierx_data_root_probe",
        "frontierx_event_queue_probe",
        "frontierx_dynamic_library_probe",
        "frontierx_event_system_probe",
        "frontierx_hotkey_event_probe",
        "frontierx_profile_parser_probe",
        "frontierx_native_dacom_bootstrap_probe",
        "frontierx_native_heap_probe",
        "frontierx_view_parser_probe",
        "frontierx_preference_store_probe",
        "frontierx_native_user_settings_probe",
        "frontierx_native_user_defaults_probe",
        "frontierx_encoded_handle_probe",
        "frontierx_dacom_runtime_probe",
        "frontierx_dacom_interface_probe",
        "frontierx_stack_address_probe",
        "frontierx_particle_context_probe",
        "frontierx_math_core_probe",
        "frontierx_ray_geometry_probe",
        "frontierx_render_submission_probe",
        "frontierx_render_pipeline_probe",
        "frontierx_render_batcher_header_probe",
        "frontierx_vertex_buffer_manager_probe",
        "frontierx_texture_library_owner",
        "frontierx_game_material_manager_probe",
        "frontierx_state_material_probe",
        "frontierx_math_accessor_probe",
        "frontierx_render_batcher_runtime_probe",
        "frontierx_bmpooljr_probe",
        "frontierx_profile_buffer_probe",
        "frontierx_profile_document_probe",
        "frontierx_headless",
        "frontierx_sdl3_platform",
        "frontierx_sdl3_window_probe",
        "frontierx_sdl3_gpu_probe",
        "frontierx_legacy_input_probe",
        "frontierx_native_window_manager_probe",
        "frontierx_app_mglobals_owner",
        "frontierx_native_shell"
      ]
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug",
      "targets": [
        "frontierx_layout_probe",
        "frontierx_tinyxml_probe",
        "frontierx_string_table_file_text_probe",
        "frontierx_platform_time_probe",
        "frontierx_data_root_probe",
        "frontierx_event_queue_probe",
        "frontierx_dynamic_library_probe",
        "frontierx_event_system_probe",
        "frontierx_hotkey_event_probe",
        "frontierx_profile_parser_probe",
        "frontierx_native_dacom_bootstrap_probe",
        "frontierx_native_heap_probe",
        "frontierx_view_parser_probe",
        "frontierx_preference_store_probe",
        "frontierx_native_user_settings_probe",
        "frontierx_native_user_defaults_probe",
        "frontierx_encoded_handle_probe",
        "frontierx_dacom_runtime_probe",
        "frontierx_dacom_interface_probe",
        "frontierx_stack_address_probe",
        "frontierx_particle_context_probe",
        "frontierx_math_core_probe",
        "frontierx_ray_geometry_probe",
        "frontierx_render_submission_probe",
        "frontierx_render_pipeline_probe",
        "frontierx_render_batcher_header_probe",
        "frontierx_vertex_buffer_manager_probe",
        "frontierx_texture_library_owner",
        "frontierx_game_material_manager_probe",
        "frontierx_state_material_probe",
        "frontierx_math_accessor_probe",
        "frontierx_render_batcher_runtime_probe",
        "frontierx_bmpooljr_probe",
        "frontierx_profile_buffer_probe",
        "frontierx_profile_document_probe",
        "frontierx_headless",
        "frontierx_sdl3_platform",
        "frontierx_sdl3_window_probe",
        "frontierx_sdl3_gpu_probe",
        "frontierx_legacy_input_probe",
        "frontierx_native_window_manager_probe",
        "frontierx_app_mglobals_owner",
        "frontierx_native_shell"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
